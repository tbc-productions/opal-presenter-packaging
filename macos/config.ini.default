[executables]

[paths]
branch = path/to/opal-presenter
icon = %(here)s/OpalPresenter.icns
bundle_info = %(here)s/Info.plist
hooks = %(here)s/../pyinstaller-hooks
dmg_settings = %(here)s/settings.py
license = %(here)s/LICENSE.txt

[transifex]
username =
password =

[codesigning]
certificate = net.tbcproductions.OpalPresenter
